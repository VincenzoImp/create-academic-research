# Local MCP secrets. Copy this file to .env (gitignored) and fill in the keys:
#   cp .env.example .env
# .env is the single secret store; the servers in .mcp.json source it at
# launch, so keep every line shell-valid KEY=value (quote any value with
# spaces). Every always-on SOTA server runs WITHOUT a key — the keys below are
# optional rate-limit / source boosts. To add a keyed server, declare its var
# here and add its block to .mcp.json (see README -> MCP servers).

# Semantic Scholar — optional, raises rate limits (used by the semantic-scholar
# and paper-search servers). https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex — optional; OpenAlex works without a key, this only adds the polite
# pool. https://docs.openalex.org/
OPENALEX_API_KEY=

# paper-search (multi-source discovery aggregator) — optional: any valid email
# enables Unpaywall open-access PDF lookup. Keep paper-search's Sci-Hub and
# Google-Scholar-scraping sources OFF (no-scraping rule); they are off by default.
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=
